{
  "name": "vantanthedev-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc -p tsconfig.server.json && node -e \"fs.mkdirSync('dist-server/server',{recursive:true});fs.copyFileSync('server/schema.sql','dist-server/server/schema.sql')\" && tsc -p tsconfig.json && vite build",
    "start": "node dist-server/server/index.js",
    "db:seed": "tsx server/seed.ts",
    "admin:create": "tsx server/create-admin.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
