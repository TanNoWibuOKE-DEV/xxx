{
  "name": "vantanthedev-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc -p tsconfig.server.json && node -e \"fs.mkdirSync('dist-server/server',{recursive:true});fs.copyFileSync('server/schema.sql','dist-server/server/schema.sql')\" && tsc -p tsconfig.json && vite build",
    "start": "node dist-server/server/index.js",
    "db:seed": "tsx server/seed.ts",
    "admin:create": "tsx server/create-admin.ts",
    "db:migrate-mysql": "tsx server/migrate-all-to-mysql.ts"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "framer-motion": "^14.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
